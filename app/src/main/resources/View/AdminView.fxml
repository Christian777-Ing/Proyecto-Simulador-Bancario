<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.simulador.bancario.controlador.AdminController">
   <children>
      <HBox alignment="CENTER_RIGHT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: #1a252f;">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="SISTEMA BANCARIO - PANEL DE CONTROL" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Cerrar Sesión" />
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>

      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: #f4f7f6;">
        <tabs>
          <Tab text="Resumen General">
               <content>
                  <VBox spacing="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        
                        <HBox spacing="20.0">
                           <children>
                              <VBox prefHeight="100.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
                                 <children>
                                    <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;" text="CAPITAL EN CUSTODIA" />
                                    <Label fx:id="lblDineroTotal" style="-fx-text-fill: #27ae60; -fx-font-size: 26; -fx-font-weight: bold;" text="\$ 0.00" />
                                 </children>
                                 <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                              </VBox>

                              <VBox prefHeight="100.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
                                 <children>
                                    <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;" text="TOTAL CLIENTES" />
                                    <Label fx:id="lblTotalUsuarios" style="-fx-text-fill: #3498db; -fx-font-size: 26; -fx-font-weight: bold;" text="0" />
                                 </children>
                                 <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                              </VBox>

                              <VBox prefHeight="100.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #2c3e50; -fx-background-radius: 10;">
                                 <children>
                                    <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 13;" text="USUARIOS BLOQUEADOS" />
                                    <Label fx:id="lblUsuariosBloqueados" style="-fx-text-fill: #e74c3c; -fx-font-size: 26; -fx-font-weight: bold;" text="0" />
                                 </children>
                                 <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                              </VBox>
                           </children>
                        </HBox>

                        <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Listado Global de Usuarios" />
                        
                        <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colId" prefWidth="100.0" text="ID Usuario" />
                            <TableColumn fx:id="colUsername" prefWidth="300.0" text="Nombre de Usuario" />
                            <TableColumn fx:id="colRol" prefWidth="200.0" text="Rol Asignado" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </content>
            </Tab>

          <Tab text="Registrar Nuevo Cliente">
               <content>
                  <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                     <content>
                        <VBox spacing="15.0">
                           <padding>
                              <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                           </padding>
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2c3e50;" text="Credenciales de Acceso" />
                              <HBox spacing="15.0">
                                 <children>
                                    <TextField fx:id="txtNewUser" prefHeight="35.0" promptText="Nombre de usuario" HBox.hgrow="ALWAYS" />
                                    <PasswordField fx:id="txtNewPass" prefHeight="35.0" promptText="Contraseña" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <Separator prefWidth="200.0">
                                 <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
                              </Separator>
                              <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #2c3e50;" text="Datos Personales del Cliente" />
                              <GridPane hgap="15.0" vgap="15.0">
                                <columnConstraints>
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                </columnConstraints>
                                <rowConstraints>
                                  <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                  <RowConstraints minHeight="10.0" prefHeight="35.0" vgrow="SOMETIMES" />
                                </rowConstraints>
                                 <children>
                                    <TextField fx:id="txtPNombre" promptText="Primer Nombre" />
                                    <TextField fx:id="txtSNombre" promptText="Segundo Nombre" GridPane.columnIndex="1" />
                                    <TextField fx:id="txtPApellido" promptText="Primer Apellido" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtSApellido" promptText="Segundo Apellido" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                    <TextField fx:id="txtCedula" promptText="Cédula / ID" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtEmail" promptText="Correo Electrónico" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    <TextField fx:id="txtTelefono" promptText="Teléfono de contacto" GridPane.rowIndex="3" />
                                    <TextField fx:id="txtDireccion" promptText="Dirección de domicilio" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    <DatePicker fx:id="dpFechaNac" maxWidth="1.7976931348623157E308" promptText="Fecha de Nacimiento" GridPane.rowIndex="4" />
                                    <ComboBox fx:id="cbSexo" maxWidth="1.7976931348623157E308" promptText="Sexo" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                 </children>
                              </GridPane>
                              <HBox alignment="CENTER_RIGHT" prefHeight="60.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#onGuardarNuevoCliente" prefHeight="45.0" prefWidth="250.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-cursor: hand; -fx-background-radius: 5;" text="REGISTRAR CLIENTE" />
                                 </children>
                                 <padding><Insets top="10.0" /></padding>
                              </HBox>
                           </children>
                        </VBox>
                     </content>
                  </ScrollPane>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </children>
</VBox>