<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="proyecto.simulador.bancario.controlador.RegistroUsuarioController"
      style="-fx-background-color: #f4f4f4;">
    <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>

    <Label text="Paso 1: Crear Cuenta" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
    <Label text="Defina sus credenciales de acceso" style="-fx-text-fill: gray;"/>

    <GridPane hgap="10" vgap="15" alignment="CENTER">
        <Label text="Nombre de Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Solo letras y números"/>
        
        <Label text="Contraseña:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="txtPass" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Min. 8 caracteres"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Siguiente" onAction="#onSiguiente" prefWidth="120" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Cancelar" onAction="#onVolver" prefWidth="100"/>
    </HBox>
</VBox>