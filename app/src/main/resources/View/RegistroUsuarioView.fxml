<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane style="-fx-background-color: #f0f2f5;" xmlns:fx="http://javafx.com/fxml" 
           fx:controller="proyecto.simulador.bancario.controlador.RegistroUsuarioController">
    
    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="450" maxHeight="550"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        
        <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 30; -fx-background-radius: 15 15 0 0;">
            <Text text="CREAR CUENTA" style="-fx-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>
            <HBox alignment="CENTER" spacing="10">
                <Label text="USUARIO" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-width: 0 0 2 0;"/>
                <Label text=" ➔ " style="-fx-text-fill: #abd4f1;"/>
                <Label text="DATOS PERSONALES" style="-fx-text-fill: #abd4f1;"/>
            </HBox>
        </VBox>

        <VBox spacing="20" style="-fx-padding: 40;">
            
            <VBox spacing="15">
                <VBox spacing="5">
                    <Label text="Nombre de Usuario" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <TextField fx:id="txtUser" promptText="Ej: Juan2024" 
                               style="-fx-padding: 10; -fx-background-color: #f9f9f9; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                    <Label text="Use solo letras y números." style="-fx-text-fill: #95a5a6; -fx-font-size: 10;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Contraseña Segura" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                    <PasswordField fx:id="txtPass" promptText="••••••••" 
                                   style="-fx-padding: 10; -fx-background-color: #f9f9f9; -fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                    
                    <StackPane alignment="CENTER_LEFT">
                        <ProgressBar fx:id="progressFuerza" prefWidth="330" progress="0.0" 
                                     style="-fx-pref-height: 4; -fx-background-insets: 0;"/>
                    </StackPane>
                    <Label fx:id="lblEstadoClave" text="Esperando contraseña..." style="-fx-font-size: 10; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </VBox>

            <HBox spacing="10" style="-fx-background-color: #e8f4fd; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="ℹ" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
                <Label text="La clave debe tener 8+ caracteres, Mayúscula y Símbolo." 
                       style="-fx-text-fill: #2980b9; -fx-font-size: 10;" wrapText="true"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button text="Volver" onAction="#onVolver" 
                        style="-fx-background-color: transparent; -fx-text-fill: #95a5a6; -fx-cursor: hand;"/>
                
                <Button fx:id="btnSiguiente" text="Siguiente Paso" onAction="#onSiguiente"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>