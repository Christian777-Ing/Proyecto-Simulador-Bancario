<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="proyecto.simulador.bancario.controlador.LoginController"
           stylesheets="@/css/bank-theme.css">

    <ImageView fitWidth="1200" fitHeight="800" preserveRatio="false">
        <image>
            <Image url="@/img/bg-bank.jpg"/>
        </image>
    </ImageView>

    <VBox spacing="20" alignment="CENTER"
          style="-fx-background-color: rgba(255,255,255,0.95); -fx-padding: 40; -fx-background-radius: 20; 
                 -fx-max-width: 400; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 10);">

        <VBox alignment="CENTER" spacing="10">
            <ImageView fitWidth="70" preserveRatio="true">
                <Image url="@/img/logo.png"/>
            </ImageView>
            <Label text="BANCO DIGITAL" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0A2A43;"/>
            <Label text="Bienvenido de nuevo" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14;"/>
        </VBox>

        <VBox spacing="12">
            <TextField fx:id="txtUsername" promptText="Nombre de usuario" prefHeight="45"
                       style="-fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
            
            <PasswordField fx:id="txtPassword" promptText="Contraseña" prefHeight="45"
                           style="-fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
            
            <Label fx:id="lblMensajeError" text="Usuario o clave incorrecta" visible="false" managed="false"
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 12; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER">
            <Button fx:id="btnIngresar" text="INGRESAR" onAction="#onLogin" 
                    maxWidth="Infinity" prefHeight="45"
                    style="-fx-background-color: #0A2A43; -fx-text-fill: white; -fx-font-weight: bold; 
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
            
            <ProgressIndicator fx:id="pgCarga" prefWidth="30" prefHeight="30" visible="false" managed="false"/>
        </VBox>

        <Separator prefWidth="250">
            <VBox.margin><Insets top="10" bottom="10"/></VBox.margin>
        </Separator>

        <HBox alignment="CENTER" spacing="5">
            <Label text="¿No tienes cuenta?" style="-fx-text-fill: #546E7A;"/>
            <Hyperlink text="Regístrate aquí" onAction="#onIrARegistro" style="-fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</StackPane>
