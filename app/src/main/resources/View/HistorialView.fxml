<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="800" prefHeight="600" xmlns:fx="http://javafx.com/fxml" 
            fx:controller="proyecto.simulador.bancario.controlador.HistorialController">
    <top>
        <Label text="Historial de Transacciones" 
               style="-fx-font-size: 20; -fx-padding: 20; -fx-font-weight: bold; -fx-text-fill: #0A2A43;"/>
    </top>
    <center>
        <TableView fx:id="tablaTransacciones" style="-fx-margin: 10;">
            <columns>
                <TableColumn text="Fecha" fx:id="colFecha" prefWidth="180"/>
                <TableColumn text="Tipo" fx:id="colTipo" prefWidth="120"/>
                <TableColumn text="Monto" fx:id="colMonto" prefWidth="120"/>
                <TableColumn text="Detalle" fx:id="colDestino" prefWidth="150"/>
            </columns>
            
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            
            <placeholder>
                <Label text="No hay movimientos registrados en esta cuenta." />
            </placeholder>
        </TableView>
    </center>
</BorderPane>