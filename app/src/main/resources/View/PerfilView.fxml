<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" prefWidth="550" prefHeight="700" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.simulador.bancario.controlador.PerfilController">
    <VBox spacing="20" style="-fx-background-color: #f5f6fa; -fx-padding: 30;">
        
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Circle radius="45" fill="#0A2A43" stroke="#3498db" strokeWidth="3"/>
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="lblNombreCompleto" text="NOMBRE DEL CLIENTE" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2f3640;"/>
                <Label fx:id="lblCedula" text="C.I. 0000000000" style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
            </VBox>
        </VBox>

        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Label text="DETALLES PERSONALES" style="-fx-font-weight: bold; -fx-text-fill: #3498db; -fx-font-size: 14px;"/>
            <Separator/>
            
            <GridPane vgap="15" hgap="20">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Usuario:" GridPane.rowIndex="0" style="-fx-text-fill: #7f8c8d;"/>
                <TextField fx:id="txtUsername" editable="false" style="-fx-background-color: #f1f2f6; -fx-border-color: #dcdde1; -fx-border-radius: 5;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="1" style="-fx-text-fill: #7f8c8d;"/>
                <TextField fx:id="txtEmail" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="2" style="-fx-text-fill: #7f8c8d;"/>
                <TextField fx:id="txtTelefono" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Dirección:" GridPane.rowIndex="3" style="-fx-text-fill: #7f8c8d;"/>
                <TextArea fx:id="txtDireccion" prefHeight="70" wrapText="true" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>

        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <HBox alignment="CENTER_LEFT">
                <Label text="SEGURIDAD DE LA CUENTA" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnMostrarCambioClave" text="Modificar Clave" onAction="#toggleSeccionSeguridad" style="-fx-background-color: #f1f2f6; -fx-cursor: hand; -fx-text-fill: #2f3640; -fx-font-size: 11px;"/>
            </HBox>
            
            <VBox fx:id="seccionSeguridad" spacing="15" visible="false" managed="false" style="-fx-padding: 15 0 0 0;">
                <Separator/>
                <PasswordField fx:id="txtClaveActual" promptText="Contraseña Actual" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                <HBox spacing="10">
                    <PasswordField fx:id="txtClaveNueva" promptText="Nueva Contraseña" HBox.hgrow="ALWAYS" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                    <PasswordField fx:id="txtClaveConfirmar" promptText="Confirmar Nueva" HBox.hgrow="ALWAYS" style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                </HBox>
                <VBox spacing="5">
                    <ProgressBar fx:id="progressFuerza" maxWidth="Infinity" prefHeight="8" progress="0.0" style="-fx-accent: #e74c3c;"/>
                    <Label fx:id="lblEstadoClave" text="Fuerza de seguridad" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </VBox>
        </VBox>

        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 20 0;">
            <Button text="Cerrar" onAction="#onCancelar" style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-cursor: hand;"/>
            <Button text="GUARDAR CAMBIOS" onAction="#onGuardar" prefHeight="40" prefWidth="180" 
                    style="-fx-background-color: #0A2A43; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</ScrollPane>