<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="0" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx" 
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="proyecto.simulador.bancario.controlador.PerfilController" 
      prefWidth="480" style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #dcdde1;">
    
    <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #0A2A43; -fx-padding: 25; -fx-background-radius: 14 14 0 0;">
        <Text text="CONFIGURACIÓN DE PERFIL" style="-fx-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Text text="Mantenga sus datos actualizados para mayor seguridad" style="-fx-fill: #bdc3c7; -fx-font-size: 11px;"/>
    </VBox>

    <VBox spacing="15" style="-fx-padding: 25;">
        
        <Label text="Información de Cuenta" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <GridPane vgap="10" hgap="15">
            <columnConstraints>
                <ColumnConstraints prefWidth="100"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            
            <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtUsername" editable="false" focusTraversable="false"
                       style="-fx-background-color: #f8f9fa; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-text-fill: #95a5a6;" 
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Correo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtEmail" promptText="correo@ejemplo.com"
                       style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>

        <Separator style="-fx-padding: 10 0;"/>

        <Label text="Cambio de Contraseña" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        
        <PasswordField fx:id="txtClaveActual" promptText="Contraseña Actual" 
                        style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
        
        <HBox spacing="10">
            <VBox HBox.hgrow="ALWAYS" spacing="5">
                <PasswordField fx:id="txtClaveNueva" promptText="Nueva Contraseña" 
                                style="-fx-border-color: #dcdde1; -fx-border-radius: 5;"/>
                <ProgressBar fx:id="progressFuerza" prefHeight="5" prefWidth="200" progress="0.0" 
                             style="-fx-accent: #e74c3c;" visible="false"/>
                <Label fx:id="lblEstadoClave" text="Fuerza: Muy débil" style="-fx-font-size: 10; -fx-text-fill: #e74c3c;" visible="false"/>
            </VBox>
            
            <PasswordField fx:id="txtClaveConfirmar" promptText="Confirmar Nueva" 
                            style="-fx-border-color: #dcdde1; -fx-border-radius: 5;" HBox.hgrow="ALWAYS"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="5" style="-fx-background-color: #fcf8e3; -fx-padding: 10; -fx-border-color: #faebcc; -fx-border-radius: 5;">
            <Text text="ⓘ" style="-fx-font-weight: bold; -fx-fill: #8a6d3b;"/>
            <Text text="Mínimo 8 caracteres, 1 Mayúscula, 1 Número y 1 Símbolo." 
                  style="-fx-fill: #8a6d3b; -fx-font-size: 10px;" wrappingWidth="350"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
            <Button text="Cancelar" onAction="#onCancelar" 
                    style="-fx-background-color: transparent; -fx-text-fill: #95a5a6; -fx-cursor: hand;"/>
            <Button text="ACTUALIZAR PERFIL" onAction="#onGuardar" 
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>