<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="proyecto.simulador.bancario.controlador.RegistroClienteController"
      style="-fx-background-color: #f4f4f4;">

    <padding>
        <Insets top="20" right="40" bottom="20" left="40"/>
    </padding>

    <Label text="Paso 2: Información Personal"
           style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">

        <Label text="Primer Nombre:" GridPane.rowIndex="0"/>
        <TextField fx:id="txtPNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Segundo Nombre:" GridPane.rowIndex="1"/>
        <TextField fx:id="txtSNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Primer Apellido:" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPApellido" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Segundo Apellido:" GridPane.rowIndex="3"/>
        <TextField fx:id="txtSApellido" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Cédula (10 dígitos):" GridPane.rowIndex="4"/>
        <TextField fx:id="txtCedula" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Fecha Nacimiento:" GridPane.rowIndex="5"/>
        <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Sexo:" GridPane.rowIndex="6"/>
        <ComboBox fx:id="cbSexo" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Teléfono:" GridPane.rowIndex="7"/>
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label text="Email:" GridPane.rowIndex="8"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

        <Label text="Dirección:" GridPane.rowIndex="9"/>
        <TextField fx:id="txtDir" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

    </GridPane>

    <HBox spacing="15" alignment="CENTER">
        <padding>
            <Insets top="10"/>
        </padding>
        
        <Button text="Completar Registro"
                prefWidth="200"
                onAction="#onRegistrar"
                style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-font-weight:bold; -fx-cursor: hand;"/>

        <Button text="Cancelar"
                prefWidth="100"
                onAction="#onCancelar"
                style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-font-weight:bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>