<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<StackPane style="-fx-background-color: #f0f2f5;" xmlns:fx="http://javafx.com/fxml" 
           fx:controller="proyecto.simulador.bancario.controlador.RegistroClienteController">
    
    <VBox spacing="0" alignment="TOP_CENTER" maxWidth="550" maxHeight="700"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        
        <VBox spacing="8" alignment="CENTER" style="-fx-background-color: #3498db; -fx-padding: 25; -fx-background-radius: 15 15 0 0;">
            <Text text="INFORMACIÓN PERSONAL" style="-fx-fill: white; -fx-font-size: 20; -fx-font-weight: bold; -fx-letter-spacing: 1;"/>
            <HBox alignment="CENTER" spacing="10">
                <Label text="USUARIO ✓" style="-fx-text-fill: #d1f2eb;"/>
                <Label text=" ➔ " style="-fx-text-fill: #d1f2eb;"/>
                <Label text="DATOS PERSONALES" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: white; -fx-border-width: 0 0 2 0;"/>
            </HBox>
        </VBox>

        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;">
            <VBox spacing="20" style="-fx-padding: 30;">
                
                <VBox spacing="10">
                    <Label text="Nombres y Apellidos" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <HBox spacing="10">
                        <TextField fx:id="txtPNombre" promptText="Primer Nombre" HBox.hgrow="ALWAYS" style="-fx-padding: 8;"/>
                        <TextField fx:id="txtSNombre" promptText="Segundo Nombre" HBox.hgrow="ALWAYS" style="-fx-padding: 8;"/>
                    </HBox>
                    <HBox spacing="10">
                        <TextField fx:id="txtPApellido" promptText="Primer Apellido" HBox.hgrow="ALWAYS" style="-fx-padding: 8;"/>
                        <TextField fx:id="txtSApellido" promptText="Segundo Apellido" HBox.hgrow="ALWAYS" style="-fx-padding: 8;"/>
                    </HBox>
                </VBox>

                <Separator/>

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Cédula (10 dígitos)" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtCedula" promptText="0123456789"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Fecha de Nacimiento" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="dpFecha" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Sexo" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="cbSexo" maxWidth="Infinity" promptText="Seleccione..."/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Teléfono" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtTelefono" promptText="09XXXXXXXX"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="2">
                        <Label text="Correo Electrónico" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtEmail" promptText="correo@ejemplo.com"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnSpan="2" GridPane.rowIndex="3">
                        <Label text="Dirección Domiciliaria" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
                        <TextField fx:id="txtDir" promptText="Calle, Número, Ciudad"/>
                    </VBox>
                </GridPane>

                <Label text="* Todos los campos son obligatorios para la apertura de cuenta." 
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 10;"/>

                <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Cancelar" onAction="#onCancelar" 
                            style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-cursor: hand;"/>
                    
                    <Button text="COMPLETAR REGISTRO" onAction="#onRegistrar"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12 25; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</StackPane>