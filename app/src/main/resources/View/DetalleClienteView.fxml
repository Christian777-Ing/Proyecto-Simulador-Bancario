<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="600.0" spacing="20.0" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyecto.simulador.bancario.controlador.DetalleClienteController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
         <children>
            <VBox>
               <children>
                  <Label fx:id="lblNombre" text="Nombre del Cliente" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblEstado" text="ACTIVO" textFill="#27ae60">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
      </HBox>

      <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Cédula:" textFill="#7f8c8d">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblCedula" text="-" GridPane.columnIndex="1" />
            
            <Label text="Sexo:" textFill="#7f8c8d" GridPane.columnIndex="2">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblSexo" text="-" GridPane.columnIndex="3" />

            <Label text="Email:" textFill="#7f8c8d" GridPane.rowIndex="1">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblEmail" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Teléfono:" textFill="#7f8c8d" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblTelefono" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Dirección:" textFill="#7f8c8d" GridPane.rowIndex="2">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <Label fx:id="lblDireccion" text="-" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
         </children>
         <VBox.margin>
            <Insets left="20.0" right="20.0" />
         </VBox.margin>
      </GridPane>

      <Separator prefWidth="200.0" />

      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Label text="Cuentas Bancarias Asociadas" textFill="#2c3e50">
               <font><Font name="System Bold" size="16.0" /></font>
            </Label>
            <TableView fx:id="tablaCuentas" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colNumero" text="Número de Cuenta" />
                <TableColumn fx:id="colTipo" text="Tipo" />
                <TableColumn fx:id="colSaldo" text="Saldo Actual" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" />
         </padding>
      </VBox>

      <HBox alignment="CENTER_RIGHT" prefHeight="50.0" prefWidth="200.0" spacing="10.0" style="-fx-background-color: #ecf0f1;">
         <children>
            <Button mnemonicParsing="false" onAction="#cerrarVentana" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Cerrar" />
         </children>
         <padding><Insets right="20.0" /></padding>
      </HBox>
   </children>
</VBox>