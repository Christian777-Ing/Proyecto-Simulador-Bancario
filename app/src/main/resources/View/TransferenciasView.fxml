<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" alignment="TOP_CENTER" prefWidth="450" 
      style="-fx-background-color: #F4F7F9; -fx-padding: 30;"
      xmlns:fx="http://javafx.com/fxml" 
      fx:controller="proyecto.simulador.bancario.controlador.TransferenciaController">

    <VBox spacing="5" alignment="CENTER">
        <Label text="Nueva Transferencia" 
               style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0A2A43;"/>
        <Label text="Complete los datos del destinatario" 
               style="-fx-text-fill: #546E7A; -fx-font-size: 14;"/>
    </VBox>

    <VBox spacing="15" 
          style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; 
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
        
        <VBox spacing="5">
            <Label text="Cuenta de Origen" style="-fx-font-weight: bold; -fx-text-fill: #78909C;"/>
            <Label fx:id="lblCuentaOrigen" text="Cargando cuenta..." 
                   style="-fx-font-size: 15; -fx-text-fill: #0A2A43;"/>
            <Label fx:id="lblSaldoOrigen" text="Saldo disponible: $0.00" 
                   style="-fx-font-size: 13; -fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
        </VBox>

        <Separator/>

        <VBox spacing="10">
            <Label text="Número de Cuenta Destino" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtCuentaDestino" promptText="Ej: AC17000000" 
                       style="-fx-pref-height: 40; -fx-background-radius: 5;"/>
            
            <Label text="Cédula del Titular" style="-fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="txtCedulaDestino" promptText="Identificación" 
                           HBox.hgrow="ALWAYS" style="-fx-pref-height: 40; -fx-background-radius: 5;"/>
                <Button text="Validar" onAction="#onVerificarDestinatario"
                        style="-fx-background-color: #0A2A43; -fx-text-fill: white; -fx-pref-height: 40; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <VBox fx:id="paneValidacion" spacing="5" alignment="CENTER" 
              style="-fx-background-color: #E8F5E9; -fx-padding: 10; -fx-background-radius: 5;" 
              visible="false">
            <Label fx:id="lblNombreDestinatario" text="Nombre del Titular" 
                   style="-fx-text-fill: #2E7D32; -fx-font-weight: bold;"/>
        </VBox>

        <Separator/>

        <VBox spacing="10">
            <Label text="Monto a Transferir" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtMonto" promptText="0.00" 
                       style="-fx-pref-height: 45; -fx-font-size: 18; -fx-font-weight: bold; -fx-alignment: center;"/>
        </VBox>
    </VBox>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Cancelar" onAction="#onCancelar" prefWidth="120"
                style="-fx-background-color: #ECEFF1; -fx-text-fill: #455A64; -fx-pref-height: 40; -fx-background-radius: 8; -fx-cursor: hand;"/>
        <Button fx:id="btnConfirmar" text="Confirmar Envío" onAction="#onConfirmarTransferencia" 
                prefWidth="200" disable="true"
                style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

</VBox>