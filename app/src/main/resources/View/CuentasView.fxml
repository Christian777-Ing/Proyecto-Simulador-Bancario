<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="proyecto.simulador.bancario.controlador.CuentaController"
            stylesheets="@/css/bank-theme.css"
            prefWidth="900.0" prefHeight="600.0"> 
    
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-padding:20; -fx-background-color:#0A2A43;">
            <Label text="Panel de Control - Mis Cuentas"
                   style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tablaCuentas" style="-fx-margin: 10;">
            <columns>
                <TableColumn text="N° Cuenta" fx:id="colNumero" prefWidth="250"/>
                <TableColumn text="Tipo de Cuenta" fx:id="colTipo" prefWidth="150"/>
                <TableColumn text="Saldo Disponible" fx:id="colSaldo" prefWidth="150"/>
                <TableColumn text="Estado" fx:id="colEstado" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No se encontraron cuentas asociadas." style="-fx-text-fill: gray;"/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="20" alignment="CENTER"
              style="-fx-padding:25; -fx-background-color: #f4f4f4;">
            
            <Button text="+ Abrir Nueva Cuenta" onAction="#onNuevaCuenta"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                    prefHeight="40"/>

            <Separator orientation="VERTICAL" />

            <Button fx:id="btnDepositar" text="Depositar" onAction="#onDepositar"
                    styleClass="button btn-success" prefHeight="40" prefWidth="110" 
                    style="-fx-cursor: hand;"/>
            
            <Button fx:id="btnRetirar" text="Retirar" onAction="#onRetirar"
                    styleClass="button btn-danger" prefHeight="40" prefWidth="110" 
                    style="-fx-cursor: hand;"/>
            
            <Button fx:id="btnHistorial" text="Historial" onAction="#onVerHistorial"
                    styleClass="button btn-primary" prefHeight="40" prefWidth="110" 
                    style="-fx-cursor: hand;"/>
                    
            <Button text="Transferir" onAction="#onTransferir" 
                    styleClass="button btn-info" prefHeight="40" prefWidth="100"/>
        </HBox>
    </bottom>
</BorderPane>