<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.effect.DropShadow?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" 
            style="-fx-background-color: #f4f7f6;" 
            xmlns="http://javafx.com/fxml/1" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="proyecto.simulador.bancario.controlador.CuentaController">
    
    <left>
        <VBox prefWidth="240" spacing="15" style="-fx-background-color: #0A2A43; -fx-padding: 25;">
            <VBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 30 0;">
                <Circle fill="#3498db" radius="35">
                    <effect>
                        <DropShadow color="#00000044" radius="10" />
                    </effect>
                </Circle>
                <Label style="-fx-text-fill: #bdc3c7; -fx-font-size: 10; -fx-letter-spacing: 2;" text="BIENVENIDO" />
                <Label fx:id="lblNombreUsuario" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="Usuario Cliente" />
            </VBox>

            <Separator opacity="0.1" />
            
            <Button maxWidth="Infinity" onAction="#onRefrescar" 
                    style="-fx-background-color: #1a3a5a; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;" 
                    text="🏠  Mis Cuentas" />
            
            <Button maxWidth="Infinity" onAction="#onAbrirPerfil" 
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-alignment: CENTER_LEFT; -fx-padding: 12; -fx-cursor: hand;" 
                    text="👤  Mi Perfil" />
            
            <Button fx:id="btnAdminPanel" managed="false" maxWidth="Infinity" onAction="#onAbrirAdmin" 
                    style="-fx-background-color: #f1c40f; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-background-radius: 8;" 
                    text="⚙  Administración" visible="false" />

            <Region VBox.vgrow="ALWAYS" />
            
            <Button maxWidth="Infinity" onAction="#onLogout" 
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8; -fx-cursor: hand;" 
                    text="🚪  Cerrar Sesión" />
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-padding: 30;">
            
        <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 8);">
            <Label style="-fx-text-fill: #95a5a6; -fx-font-size: 13; -fx-font-weight: bold; -fx-letter-spacing: 1;" text="SALDO TOTAL DISPONIBLE" />
            <HBox alignment="BASELINE_LEFT" spacing="2">
                <Label fx:id="lblSaldoTotal" style="-fx-text-fill: #2ecc71; -fx-font-size: 42; -fx-font-weight: bold;" text="\$ 0,00" />
            </HBox>
        </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Button onAction="#onNuevaCuenta" prefHeight="55" prefWidth="260" 
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 30; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(142,68,173,0.3), 10, 0, 0, 5);" 
                        text="+ Abrir Nueva Cuenta" />
            </HBox>

            <VBox spacing="15" 
                VBox.vgrow="ALWAYS" 
                style="-fx-background-color: #f0f7ff; 
                        -fx-background-radius: 15; 
                        -fx-padding: 20; 
                        -fx-border-color: #d6eaf8; 
                        -fx-border-radius: 15; 
                        -fx-border-width: 1;
                        -fx-effect: dropshadow(three-pass-box, rgba(77, 184, 255, 0.1), 15, 0, 0, 5);">
                <HBox alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Mis Productos Financieros" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtBuscar" prefWidth="300" promptText="🔍 Buscar por número o tipo..." 
                               style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-background-color: #f1f2f6;" />
                </HBox>
                
                <TableView fx:id="tablaCuentas" style="-fx-background-radius: 10; -fx-overflow-x: hidden;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNumero" prefWidth="250" text="Número de Cuenta" />
                        <TableColumn fx:id="colTipo" prefWidth="180" text="Tipo de Cuenta" />
                        <TableColumn fx:id="colSaldo" prefWidth="180" text="Saldo Disponible" />
                        <TableColumn fx:id="colEstado" prefWidth="150" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #f9f9f9; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #edeff2; -fx-border-radius: 15;">
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-font-size: 10;" text="OPERACIONES" />
                    <HBox spacing="10">
                        <Button fx:id="btnDepositar" onAction="#onDepositar" prefHeight="45" prefWidth="130"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="💵 Depositar" />
                        <Button fx:id="btnRetirar" onAction="#onRetirar" prefHeight="45" prefWidth="130"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🏧 Retirar" />
                        <Button onAction="#onTransferir" prefHeight="45" prefWidth="130"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Transferir" />
                    </HBox>
                </VBox>
                
                <Separator orientation="VERTICAL">
                    <padding><Insets left="10" right="10" /></padding>
                </Separator>
                
                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #95a5a6; -fx-font-size: 10;" text="REPORTES" />
                    <HBox spacing="10">
                        <Button onAction="#onVerHistorial" prefHeight="45" 
                                style="-fx-background-color: white; -fx-border-color: #3498db; -fx-border-radius: 8; -fx-text-fill: #3498db; -fx-cursor: hand;" text="📜 Historial" />
                        <Button onAction="#onGenerarPDF" prefHeight="45" 
                                style="-fx-background-color: white; -fx-border-color: #34495e; -fx-border-radius: 8; -fx-text-fill: #34495e; -fx-cursor: hand;" text="📄 Exportar PDF" />
                    </HBox>
                </VBox>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <Button onAction="#onDesactivarCuenta" prefHeight="45" 
                        style="-fx-background-color: transparent; -fx-text-fill: #c0392b; -fx-border-color: #c0392b; -fx-border-radius: 8; -fx-cursor: hand;" text="Desactivar Producto" />
            </HBox>
        </VBox>
    </center>
</BorderPane>