<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="proyecto.simulador.bancario.controlador.CuentaController"
            stylesheets="@/css/bank-theme.css"
            prefWidth="1100.0" prefHeight="650.0"> 
    
    <top>
        <VBox style="-fx-background-color:#0A2A43;">
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:20;">
                <Label text="Panel de Control - Mis Cuentas"
                       style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                
                <Button fx:id="btnAdminPanel" text="⚙ Admin" onAction="#onAbrirAdmin"
                        style="-fx-background-color: #f1c40f; -fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-cursor: hand;"
                        visible="false" managed="false"/>

                <Button text="👤 Mi Perfil" onAction="#onAbrirPerfil"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-border-radius: 5; -fx-cursor: hand;"/>
                
                <Button text="Cerrar Sesión" onAction="#onLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1; -fx-border-color: #ecf0f1; -fx-border-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane style="-fx-padding: 15;">
            <TableView fx:id="tablaCuentas" styleClass="modern-table" focusTraversable="true">
                <columns>
                    <TableColumn text="N° Cuenta" fx:id="colNumero" prefWidth="250"/>
                    <TableColumn text="Tipo de Cuenta" fx:id="colTipo" prefWidth="180"/>
                    <TableColumn text="Saldo Disponible" fx:id="colSaldo" prefWidth="180"/>
                    <TableColumn text="Estado" fx:id="colEstado" prefWidth="180"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <placeholder>
                    <Label text="No se encontraron cuentas activas." style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
                </placeholder>
            </TableView>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding:20; -fx-background-color: #ffffff; -fx-border-color: #dcdde1; -fx-border-width: 1 0 0 0;">
            <HBox spacing="12" alignment="CENTER">
                
                <Button text="+ Abrir Nueva Cuenta" onAction="#onNuevaCuenta"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                        prefHeight="45" focusTraversable="false"/> <Separator orientation="VERTICAL" prefHeight="40"/>

                <Button fx:id="btnDepositar" text="Depositar (Enter)" onAction="#onDepositar"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" prefHeight="45" prefWidth="130" />
                
                <Button fx:id="btnRetirar" text="Retirar" onAction="#onRetirar"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;" prefHeight="45" prefWidth="110" />
                
                <Button fx:id="btnHistorial" text="Historial" onAction="#onVerHistorial"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" prefHeight="45" prefWidth="110" />
                        
                <Button text="Transferir" onAction="#onTransferir" 
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" prefHeight="45" prefWidth="110"/>

                <Separator orientation="VERTICAL" prefHeight="40"/>

                <Button text="Descargar PDF" onAction="#onGenerarPDF"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold;" 
                        prefHeight="45" prefWidth="130"/>

                <Button text="Desactivar" onAction="#onDesactivarCuenta"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" 
                        prefHeight="45" prefWidth="110"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>