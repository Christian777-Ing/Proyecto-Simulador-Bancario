<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml" 
      fx:controller="proyecto.simulador.bancario.controlador.RegistroController"
      style="-fx-background-color: #f4f4f4;">
    <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

    <Label text="Registro de Nuevo Cliente" style="-fx-font-size: 22; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        
        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="txtPass" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Separator GridPane.columnSpan="2" GridPane.rowIndex="2"/>

        <Label text="1er Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtPNombre" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="2do Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtSNombre" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="5">
            <TextField fx:id="txtPApellido" promptText="Primer"/>
            <TextField fx:id="txtSApellido" promptText="Segundo"/>
        </HBox>

        <Label text="Cédula (10 dígitos):" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtCedula" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Fecha Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <DatePicker fx:id="dpFecha" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label text="Sexo:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <ComboBox fx:id="cbSexo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="8"/>

        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
        <TextField fx:id="txtTelf" GridPane.columnIndex="1" GridPane.rowIndex="10"/>

        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="11"/>
        <TextField fx:id="txtDir" GridPane.columnIndex="1" GridPane.rowIndex="11"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Registrar" onAction="#onRegistrar" prefWidth="120"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Cancelar" onAction="#onVolver" prefWidth="120"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
    </HBox>
</VBox>